# Runtime GPU lock (rewritten on every run)
/runs/.swarmbridge-gpu.lock
# Protocol-v1 bulky outputs: predictions/tracks are regenerated deterministically; sha256 kept in box_proto.json + input.json
/runs/uav3d_proto/**/results_nusc.json
/runs/uav3d_proto/**/tracking_result.json
/runs/uav3d_proto/**/plots/
/runs/uav3d_comm/tracking_dtcheck/**/tracking_result.json
/runs/uav3d_comm/tracking_dtcheck/**/plots/
# Windows copy of the UAV3D CenterPoint tracking code + its py3.8 venv (extra CPU tracking workers)
/external/uav3d_track_win/
/runs/uav3d_proto/.claims/

# wireless A/B/C pilot data (large, re-downloadable)
/data/wireless_abc/
/runs/wireless_abc/**/*.npy
/runs/wireless_abc/**/*.npz
/runs/wireless_abc/**/*.pt
# hybrid object-feature pilot: predictions / tracker outputs are reproducible from cached BEV + scripts; sha256 kept in summaries
/runs/hybrid_comm/**/results_nusc.json
/runs/hybrid_comm/**/tracking_result.json
/runs/hybrid_comm/m0_smoke/
/runs/hybrid_comm/codex_m2/prepared/tiles/
/runs/hybrid_comm/codex_m2/prepared/boxes/
/runs/hybrid_comm/codex_m2/**/*.tmp
